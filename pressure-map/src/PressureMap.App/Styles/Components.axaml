<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style Selector="Button"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style Selector="Button.centered-content TextBlock"><Setter Property="TextAlignment" Value="Center"/></Style>
 <Style Selector="Button.centered-content /template/ ContentPresenter"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style Selector="Button.centered-control-content /template/ ContentPresenter"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style Selector="TextBox"><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style Selector="Border.status-chip TextBlock, Border.badge TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style>
 <Style Selector="Border.kbd TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style>
 <Style Selector="Button.metric /template/ ContentPresenter"><Setter Property="CornerRadius" Value="14"/></Style>
 <Style Selector="Button.metric TextBlock"><Setter Property="TextAlignment" Value="Left"/></Style>
 <Style Selector="Button"><Setter Property="MinHeight" Value="36"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/></Style>
 <Style Selector="Button:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/></Style>
 <Style Selector="Button.accent, Button.primary"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/><Setter Property="BorderThickness" Value="0"/></Style>
 <Style Selector="Button.accent:pointerover /template/ ContentPresenter, Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/></Style>
 <Style Selector="Button.accent:pressed /template/ ContentPresenter, Button.primary:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/></Style>
 <Style Selector="Button.tonal, Button.pill"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}"/><Setter Property="BorderThickness" Value="0"/></Style>
 <Style Selector="Button.tonal:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}"/></Style>
 <Style Selector="Button.tonal:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentFaintBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}"/></Style>
 <Style Selector="Button.ghost, Button.icon"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
 <Style Selector="Button.icon"><Setter Property="MinHeight" Value="32"/><Setter Property="MinWidth" Value="32"/><Setter Property="CornerRadius" Value="999"/><Setter Property="Padding" Value="6"/></Style>
 <Style Selector="Button.danger"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/></Style>
 <Style Selector="Button.danger:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource DangerTonalBrush}"/><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Style>
 <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.5"/></Style>
 <Style Selector="Button:focus-visible"><Setter Property="BorderThickness" Value="2"/><Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Style>
 <Style Selector="TextBox, ComboBox, NumericUpDown, CalendarDatePicker"><Setter Property="MinHeight" Value="40"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/></Style>
 <Style Selector="ComboBox /template/ Border#PopupBorder">
   <Setter Property="CornerRadius" Value="10"/>
   <Setter Property="ClipToBounds" Value="True"/>
   <Setter Property="Padding" Value="4"/>
   <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
 </Style>
 <Style Selector="ComboBoxItem">
   <Setter Property="CornerRadius" Value="6"/>
   <Setter Property="MinHeight" Value="36"/>
   <Setter Property="Padding" Value="10,6"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
 </Style>
 <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
   <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}"/>
 </Style>
 <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
   <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
   <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}"/>
 </Style>
 <Style Selector="TextBox:pointerover, ComboBox:pointerover, NumericUpDown:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Style>
 <Style Selector="TextBox:focus-within, ComboBox:focus-within, NumericUpDown:focus-within"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
 <Style Selector="ToggleSwitch">
  <Setter Property="OnContent" Value="{x:Null}"/><Setter Property="OffContent" Value="{x:Null}"/>
  <Setter Property="MinHeight" Value="36"/>
  <Setter Property="Template"><ControlTemplate>
   <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
    <Border x:Name="SwitchTrack" Width="40" Height="22" CornerRadius="11" Background="{DynamicResource SwitchOffBrush}">
     <Grid x:Name="PART_MovingKnobs"><Ellipse x:Name="SwitchKnob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3"/></Grid>
    </Border>
   </StackPanel>
  </ControlTemplate></Setter>
 </Style>
 <Style Selector="ToggleSwitch:checked /template/ Border#SwitchTrack"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></Style>
 <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchKnob"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
 <Style Selector="ToggleSwitch:focus-visible /template/ Border#SwitchTrack"><Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
 <Style Selector="ToggleSwitch:disabled"><Setter Property="Opacity" Value="0.5"/></Style>
 <Style Selector="ListBox.nav ListBoxItem"><Setter Property="MinHeight" Value="40"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="RenderTransform" Value="none"/></Style>
 <Style Selector="Border.kbd"><Setter Property="CornerRadius" Value="6"/><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/><Setter Property="BorderThickness" Value="1,1,1,2"/><Setter Property="Padding" Value="8,4"/></Style>
 <Style Selector="Border.status-chip"><Setter Property="Height" Value="24"/><Setter Property="CornerRadius" Value="999"/><Setter Property="Padding" Value="10,2"/><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Style>
 <Style Selector="Border.todo-row"><Setter Property="CornerRadius" Value="8"/><Setter Property="MinHeight" Value="48"/></Style>
 <Style Selector="ProgressBar"><Setter Property="Height" Value="6"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="{DynamicResource DividerBrush}"/></Style>
 <Style Selector="ScrollBar"><Setter Property="MinWidth" Value="6"/><Setter Property="MinHeight" Value="6"/></Style>
 <Style Selector="Button.course-tab"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="CornerRadius" Value="8"/></Style>
 <Style Selector="Button.course-tab.accent"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>

 <Style Selector="Button:disabled /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Style>
 <Style Selector="TextBox /template/ TextBlock#PART_Watermark"><Setter Property="Foreground" Value="{DynamicResource PlaceholderBrush}"/></Style>
 <Style Selector="Expander.ended-courses"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="12"/></Style>
 <Style Selector="Expander.ended-courses /template/ ToggleButton"><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="12"/><Setter Property="MinHeight" Value="44"/><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/></Style>
 <Style Selector="ScrollBar /template/ Thumb"><Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}"/><Setter Property="CornerRadius" Value="3"/></Style>
 <Style Selector="ListBox.todo-list ListBoxItem"><Setter Property="CornerRadius" Value="10"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="8"/></Style>
 <Style Selector="ListBox.todo-list ListBoxItem /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="CornerRadius" Value="10"/></Style>
 <Style Selector="ListBox.todo-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/><Setter Property="CornerRadius" Value="10"/></Style>
 <Style Selector="ListBox.todo-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.todo-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentFaintBrush}"/><Setter Property="CornerRadius" Value="10"/></Style>
</Styles>
