<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PressureMap.App" RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://PressureMap/Styles/Tokens.axaml" /><ResourceInclude Source="avares://PressureMap/Styles/Icons.axaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://PressureMap/Styles/Soft.axaml" />
    <Style Selector="Button.caption-button">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="8"/><Setter Property="RenderTransform" Value="none"/><Setter Property="Transitions" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.caption-button Path"><Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="StrokeThickness" Value="1.5"/><Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/></Style>
    <Style Selector="Button.caption-button:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentFaintBrush}"/></Style>
    <Style Selector="Button.caption-button:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Style>
    <Style Selector="Button.caption-close:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#E81123"/></Style>
    <Style Selector="Button.caption-close:pointerover Path"><Setter Property="Stroke" Value="White"/></Style>
    <Style Selector="Button.pill"><Setter Property="CornerRadius" Value="999"/><Setter Property="Padding" Value="11,5"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.account"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,7"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.account:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentFaintBrush}"/></Style>
    <Style Selector="Button.account:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Style>
    <Style Selector="Button.link"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6,3"/><Setter Property="CornerRadius" Value="6"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentFaintBrush}"/></Style>
    <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="Border.todo-row"><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="8,6"/></Style>
    <Style Selector="Border.todo-row:pointerover"><Setter Property="Background" Value="{DynamicResource AccentFaintBrush}"/></Style>
    <Style Selector="ListBox.nav"><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="ListBox.todo-list ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="48"/></Style>
    <Style Selector="Window"><Setter Property="FontFamily" Value="HarmonyOS Sans SC, MiSans, Microsoft YaHei UI, Segoe UI"/></Style>
    <StyleInclude Source="avares://PressureMap/Styles/CourseTable.axaml" />
    <StyleInclude Source="avares://PressureMap/Styles/Components.axaml" /><StyleInclude Source="avares://PressureMap/Styles/DesktopGlass.axaml" />
    <StyleInclude Source="avares://PressureMap/Styles/DatePicker.axaml" />
  </Application.Styles>
</Application>

